# Base URL for the rag-integrity-guard API.
#
# Leave unset in production: vercel.json routes /api/* to the Python
# function directly, so a relative fetch from the browser is already correct.
#
# For local dev, run the API separately (from apps/api):
#   uvicorn index:app --reload --port 8000
# then uncomment the line below.
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
